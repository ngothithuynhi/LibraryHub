{
  "name": "libraryhub",
  "version": "1.0.0",
  "description": "Library Management System",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage --runInBand"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/app.js",
      "src/controllers/**/*.js",
      "src/middlewares/**/*.js",
      "src/routes/**/*.js",
      "models/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/src/server.js",
      "<rootDir>/src/config/"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 80
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngothithuynhi/LibraryHub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ngothithuynhi/LibraryHub/issues"
  },
  "homepage": "https://github.com/ngothithuynhi/LibraryHub#readme",
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
